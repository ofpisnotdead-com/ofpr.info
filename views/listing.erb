<div class="panel">
  <% if @section %><% above = trail("/#{@section}")[0...-1] %>
  <% unless above.empty? %><%== erb :_crumbs, locals: {steps: above, tail: nil} %><% end %>
  <h1 class="article__title listing__title"><%= @page_title %></h1>
  <% end %><div class="stream">
    <% @articles.each do |article| %><%== erb(expanded? ? :_entry : :_card, locals: {article: article}) %><% end %>
  </div>
  <%== erb :_pager, locals: {pager: pager(@pager_base, @start, @total)} %>
</div>
