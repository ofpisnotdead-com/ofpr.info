<div id="k2Container" class="itemListView">
	<div class="itemListCategoriesBlock"></div>
	<div class="itemList">
		<div id="itemListPrimary">
<% @articles.first(5).each do |article| %><%== erb :"legacy/_item", locals: {article: article, group: 'groupPrimary', nodate: false} %><% end %>
		</div>
<% unless @articles.drop(5).empty? %>		<div id="itemListSecondary">
<% @articles.drop(5).each do |article| %><%== erb :"legacy/_item", locals: {article: article, group: 'groupSecondary', nodate: false} %><% end %>
		</div>
<% end %>	</div>
	<%== pager('/', @start, @total).to_html %>
</div>
