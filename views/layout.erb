<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %></title>
  <meta name="description" content="<%= share_description %>">
  <link href="<%= canonical %>" rel="canonical">
  <meta property="og:site_name" content="OFP.info 2.5">
  <meta property="og:type" content="<%= share_type %>">
  <meta property="og:title" content="<%= share_title %>">
  <meta property="og:description" content="<%= share_description %>">
  <meta property="og:url" content="<%= absolute(canonical) %>">
  <meta property="og:image" content="<%= share_image %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/images/favicon.ico" sizes="32x32">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700&family=Montserrat:wght@600&display=swap">
  <link rel="stylesheet" href="/assets/ofpr.css">
  <noscript><style>
    /* The menu is a drawer only because something can open it. */
    @media (max-width: 1024px) {
      .menu__list { display: flex !important; }
      .menu__burger { display: none !important; }
    }
  </style></noscript>
  <% if structured_data? %><script type="application/ld+json"><%== ld_json %></script>
  <% end %></head>
<body>

<header class="masthead">
  <div class="masthead__inner">
    <a class="masthead__logo" href="/"><img src="/images/banner.png" alt="OFPR.info" width="980" height="132"></a>
  </div>
</header>

<%== erb :_menu %>

<main class="page<%= ' page--wide' if wide? %>">
  <%== yield %>
  <% unless wide? %><%== erb :_aside %><% end %>
</main>

<footer class="footer">
  <p>OFPR.info archive. The news, the addons and the missions of the Operation Flashpoint
    community, 2001 to 2019. Files hosted by <a href="https://ofpisnotdead.com/">ofpisnotdead.com</a>.</p>
  <p class="footer__links"><a href="<%= page_url('/updates') %>">Updates</a>
    <a class="report__open" href="<%= issue_url %>">Report a problem, or contribute</a></p>
</footer>

<!-- Without a script this is the plain link to the issue form that the footer holds. -->
<dialog class="report" id="report">
  <h2 class="report__title">Report, or contribute</h2>
  <p>A broken download, a missing picture, an article that reads wrong. Also a file the
    archive does not have and you do, or an idea for what it should hold next.</p>
  <p>The site is open source, so a fix can arrive as a pull request as readily as a
    message.</p>
  <p class="report__links">
    <a class="report__link" href="<%= issue_url %>"><%== erb :_github %>Open an issue</a>
    <a class="report__link report__link--quiet" href="<%= discord_url %>">Ask on Discord</a>
    <a class="report__link report__link--quiet" href="<%= repo_url %>"><%== erb :_github %>The code</a>
  </p>
  <button class="report__close" type="button">Close</button>
</dialog>

<template id="missing-picture"><%== erb :_missing %></template>
<script src="/assets/ofpr.js" defer></script>
</body>
</html>
