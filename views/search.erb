<div class="panel">
  <h1 class="article__title">Search</h1>
  <form class="finder" action="/search.html" role="search">
    <input class="finder__word" type="search" name="searchword" value="<%= @query.word %>" placeholder="What are you looking for?" aria-label="Search words">
    <label>Match <select name="searchphrase">
      <% {'all' => 'all words', 'any' => 'any word', 'exact' => 'the exact phrase'}.each do |value, label| %><option value="<%= value %>"<%== ' selected' if @query.phrase == value %>><%= label %></option>
      <% end %></select></label>
    <label>Order by <select name="ordering">
      <% {'newest' => 'newest first', 'oldest' => 'oldest first', 'alpha' => 'title'}.each do |value, label| %><option value="<%= value %>"<%== ' selected' if @query.ordering == value %>><%= label %></option>
      <% end %></select></label>
    <label>Display # <select name="limit">
      <% Ofpr::SearchQuery::LIMITS.each do |limit| %><option value="<%= limit %>"<%== ' selected' if @query.per_page == limit %>><%= limit %></option>
      <% end %></select></label>
    <button type="submit">Search</button>
  </form>

  <% unless @query.blank? %><p class="finder__total"><%= number(@total) %> <%= @total == 1 ? 'result' : 'results' %> for <strong><%= @query.word %></strong></p>
  <div class="results">
    <% @articles.each do |article| %><article class="result">
      <h2 class="result__title"><a href="<%= page_url(article[:url_path]) %>"><%== highlight(article[:title]) %></a></h2>
      <p class="meta">
        <a class="chip" href="<%= page_url(section_path_of(article)) %>"><%= section_label_of(article) %></a>
        <span><%= date(article[:published_at]) %></span>
      </p>
      <p class="result__text"><%== excerpt(article) %></p>
    </article>
    <% end %>
  </div>
  <%== erb :_pager, locals: {pager: search_pager} %>
  <% end %>
</div>
