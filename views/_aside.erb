<aside class="aside">
  <% %w[Addons Missions].each do |group| %><section class="block">
    <h2 class="block__title"><%= group %></h2>
    <ul>
      <% Ofpr::Menu.group(group).each do |child| %><li>
        <a href="<%= page_url(child[:path]) %>"><%= child[:label] %> <span><%= number(counts[child[:path].delete_prefix('/')]) %></span></a>
      </li>
      <% end %>
    </ul>
  </section>
  <% end %><section class="block">
    <h2 class="block__title">The archive</h2>
    <ul>
      <li><a href="/"><%= number(Ofpr::Article.total) %> articles, 2001 to 2019</a></li>
      <li><a class="report__open" href="<%= issue_url %>">Report or contribute</a></li>
    </ul>
  </section>
</aside>
