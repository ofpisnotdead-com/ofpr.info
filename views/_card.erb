<article class="item">
  <% shot = first_picture(article) %><% if shot %><a class="item__shot" href="<%= page_url(article[:url_path]) %>">
    <img src="<%= asset(shot['thumb']) %>" alt="" loading="lazy">
  </a>
  <% end %><div class="item__text">
    <p class="meta">
      <a class="chip" href="<%= page_url(section_path_of(article)) %>"><%= section_label_of(article) %></a>
      <span><%= date(article[:published_at]) %></span>
      <% unless article[:author].to_s.empty? %><span class="meta__sep">/</span> <span><%= article[:author] %></span><% end %>
    </p>
    <h2 class="item__title"><a href="<%= page_url(article[:url_path]) %>"><%== article[:title] %></a></h2>
    <p class="item__intro"><%= intro(article) %></p>
    <a class="item__more" href="<%= page_url(article[:url_path]) %>">Read on</a>
  </div>
</article>
