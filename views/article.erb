<article class="panel">
  <%== erb :_crumbs, locals: {steps: trail(section_path), tail: @article[:title]} %>
  <h1 class="article__title"><%== @article[:title] %></h1>
  <p class="meta article__meta">
    <a class="chip" href="<%= page_url(section_path) %>"><%= section_label_of(@article) %></a>
    <span><%= date(@article[:published_at]) %></span>
    <% unless @article[:author].to_s.empty? %><span class="meta__sep">/</span> <span><%== author_link %></span><% end %>
  </p>
  <%== erb :_blocks, locals: {blocks: blocks(@article), centred: true} %>
</article>
