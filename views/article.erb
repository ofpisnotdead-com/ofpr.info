<article id="k2Container" class="itemView">           
         
          
           <header>
                                                            <h1><%== @article[:title] %></h1>
                                                            <ul>
                                                            <li><time datetime="<%= stamp(@article[:published_at]) %>"><%= @article[:published_at]&.strftime("%B %-d, %Y") %></time></li>
                                                                                          <% if river_article? %><li>Written by&nbsp;<%== author_link %></li><% end %>
                                                                                          <li><span>Published in</span> <a href="<%= page_url(section_path) %>"><%= @article[:section_label] %></a></li>
                                                                                          <li>Read <%= @article[:hits] %> times </li>
                                                                                                                                                                                                                                                                    </ul>
                              </header>
                     
                    
          
                     <div class="itemBody"> 
                                                                       <div class="itemFullText"><%== body_html(@article) %> </div>
                                        
                                        
                                        
                                                                                 <div class="itemLinks">
                                                                                </div>
                    
                                                            
                                        
                                        
                                          </div>
          
                    
          
                    </article>

