<div class="body">
  <% blocks.each do |block| %><% if block['type'] == 'prose' %><%== prose(block['markdown']) %>
  <% elsif block['type'] == 'gallery' %><% shots = shown_pictures(block['pictures']) %><% unless shots.empty? %><% alone = shots.size == 1 && !shots.first['full'] %><div class="gallery<%= ' gallery--picture' if alone %><%= ' gallery--centred' if alone && centred %>">
    <% shots.each do |shot| %><%== erb :_shot, locals: {shot: shot} %><% end %>
  </div>
  <% end %><% elsif block['type'] == 'download' %><div class="downloads">
    <% block['links'].each do |link| %><%== erb :_download, locals: {link: link, size: nil} %><% end %>
  </div>
  <% elsif block['type'] == 'needs' %><%== erb :_needs, locals: {block: block} %>
  <% elsif block['type'] == 'video' %><div class="video">
    <iframe src="https://www.youtube-nocookie.com/embed/<%= block['id'] %>" title="YouTube video" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
  </div>
  <% elsif block['type'] == 'card' %><div class="card">
    <% if block['picture'] %><a class="card__shot" href="<%= asset(block['picture']['full'] || block['picture']['thumb']) %>">
      <img src="<%= asset(block['picture']['thumb']) %>" alt="<%= block['picture']['alt'] %>">
    </a>
    <% end %><dl class="card__facts">
      <% card_fields(block).each do |label, value| %><div>
        <% if label %><dt><%= label %></dt><% end %>
        <dd><%== inline(value) %></dd>
      </div>
      <% end %>
    </dl>
    <% unless block['downloads'].empty? %><div class="card__downloads downloads">
      <% block['downloads'].each do |link| %><%== erb :_download, locals: {link: link, size: card_size(block)} %><% end %>
    </div>
    <% end %></div>
  <% end %><% end %>
</div>
